{
  "manifest_version": 3,
  "name": "X Redirector",
  "version": "1.2",
  "description": "Redirects x.com to a Nitter instance of your choice (e.g. xcancel.com, nitter.net, lightbrd.com)",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/24.png",
    "128": "icons/32.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png"
    },
    "default_title": "X Redirector",
    "default_popup": "popup.html"
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["*://x.com/*"],
  "background": {
    "service_worker": "background.js"
  }
}
